# Application
APP_NAME=API Key Gateway
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (override host with "postgres" inside Docker Compose)
DATABASE_URL=postgresql+psycopg://gateway:gateway@localhost:5432/gateway

# Redis (override host with "redis" inside Docker Compose)
REDIS_URL=redis://localhost:6379/0

# Set a strong random value in deployed environments.
SECRET_KEY=replace-this-with-a-strong-random-secret

# Required to access administrative routes. Inject a strong secret in deployments.
ADMIN_API_KEY=replace-this-with-a-strong-admin-secret

# Keep rotated API keys valid for five minutes while clients switch credentials.
API_KEY_ROTATION_GRACE_SECONDS=300
